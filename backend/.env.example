# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Box questions need Jev 1.14
JEV_MODEL=jev-1.14.0

# Set to 1 to fake Jev answers, so the app runs without a key
JEV_MOCK=0

PORT=4000

# Postgres connection string, e.g. from Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Caps per browser, to protect the Jev key when deployed publicly
LIMIT_CHECKS_PER_SECOND=4
LIMIT_CHECKS_PER_DAY=1500
LIMIT_OWNERS_PER_IP_PER_DAY=30
